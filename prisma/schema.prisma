generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClothingCategory {
  top
  bottom
  outerwear
  shoes
  accessory
}

model WardrobeItem {
  id        String           @id @default(uuid())
  userId    String           @default("local-user")
  name      String
  category  ClothingCategory
  color     String
  imageUrl  String?
  tags      String[]         @default([])
  createdAt DateTime         @default(now())

  @@map("wardrobe_items")
}

enum MessageType {
  user
  ai
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String    @default("local-user")
  name      String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      MessageType
  text      String
  createdAt DateTime    @default(now())

  @@map("messages")
}